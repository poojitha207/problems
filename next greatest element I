class Solution:
    def nextGreaterElement(self, nums1: List[int], nums2: List[int]) -> List[int]:
        st=[]
        nge={}
        nums2=nums2[::-1]
        for num in nums2:
            while st and st[-1]<=num:
                st.pop()
            if st:
                nge[num]=st[-1]
            else:
                nge[num]=-1
            st.append(num)
        res=[]
        for i in nums1:
            res.append(nge[i])
        return res
