class Solution(object):
    def moveZeroes(self, nums):
        idx=0
        for i in range(len(nums)):
            if nums[i]!=0:
                nums[idx]=nums[i]
                idx+=1
        for i in range(idx,len(nums)):
            nums[i]=0
nums=[0,1,0,3,12]
s=Solution()
s.moveZeroes(nums)
print(nums)
        
